<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_host" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
<include layout="@layout/widget_header" />
<include layout="@layout/widget_summary" />
<LinearLayout android:id="@+id/inline_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
<FrameLayout android:id="@+id/list_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:layout_marginTop="8dp">
  <ListView android:id="@+id/workout_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" android:cacheColorHint="#000000" android:background="#000000" android:contentDescription="Workout details. Scroll for more." />
</FrameLayout>
<LinearLayout android:id="@+id/agenda_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" /><LinearLayout android:id="@+id/week_strip" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:visibility="gone"><TextView android:id="@+id/day_1" style="@style/WidgetDay" android:text="M" /><TextView android:id="@+id/day_2" style="@style/WidgetDay" android:text="T" /><TextView android:id="@+id/day_3" style="@style/WidgetDay" android:text="W" /><TextView android:id="@+id/day_4" style="@style/WidgetDay" android:text="T" /><TextView android:id="@+id/day_5" style="@style/WidgetDay" android:text="F" /><TextView android:id="@+id/day_6" style="@style/WidgetDay" android:text="S" /><TextView android:id="@+id/day_7" style="@style/WidgetDay" android:text="S" /></LinearLayout>
<include layout="@layout/widget_footer" />
</LinearLayout></FrameLayout>
